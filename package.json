{
  "name": "@riven-lab/server",
  "version": "0.1.0",
  "private": true,
  "description": "Riven Analytics API server",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js"
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:push": "supabase migration up --local",
    "db:deploy": "supabase db push",
    "db:types": "supabase gen types typescript --local > src/database/types.generated.ts",
    "project:create": "tsx scripts/create-project.ts"
  },
  "dependencies": {
    "@fastify/cors": "10.0.2",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "10.2.1",
    "@supabase/supabase-js": "2.117.3",
    "dotenv": "16.4.7",
    "fastify": "5.2.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.13.4",
    "tsx": "4.19.3",
    "typescript": "5.7.3"
  }
}
